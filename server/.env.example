# Smart Warehouse Platform - Environment Configuration
# Copy to .env and fill in your values.

# === MongoDB Atlas connection string ===
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/databaseName
# IMPORTANT: Replace USERNAME, PASSWORD and CLUSTER with your own values.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/smartwarehouse

# Server port
PORT=5000

# JWT secret for token signing (change this in production!)
JWT_SECRET=smartwarehouse_secret_key_change_me_2026

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173
